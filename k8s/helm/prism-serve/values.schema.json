{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["model", "parallel", "gateway", "worker", "nats", "affinity"],
  "properties": {
    "gateway": {
      "type": "object",
      "required": [
        "replicas", "terminationGracePeriodSeconds", "startupProbe",
        "topologyGeneration", "correctnessHarness", "performanceHarness",
        "routeParityHarness", "performanceTraceCap", "image"
      ],
      "properties": {
        "replicas": {"const": 1},
        "terminationGracePeriodSeconds": {"const": 255},
        "startupProbe": {
          "type": "object",
          "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
          "properties": {
            "periodSeconds": {"const": 10},
            "timeoutSeconds": {"const": 5},
            "failureThreshold": {"const": 72}
          },
          "additionalProperties": false
        },
        "topologyGeneration": {"type": "string", "minLength": 1},
        "correctnessHarness": {
          "type": "object",
          "required": [
            "enabled", "secretName", "secretKey", "faultGateTimeoutSeconds"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1},
            "faultGateTimeoutSeconds": {"type": "number", "minimum": 1200}
          },
          "additionalProperties": false
        },
        "performanceHarness": {
          "type": "object",
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}},
          "additionalProperties": false
        },
        "routeParityHarness": {
          "type": "object",
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}},
          "additionalProperties": false
        },
        "performanceTraceCap": {"const": 8192},
        "image": {
          "type": "object",
          "required": [
            "repository", "tag", "digest", "sourceUrl", "sourceCommit",
            "pullPolicy"
          ],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {
              "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"
            },
            "sourceUrl": {
              "type": "string", "format": "uri", "minLength": 1
            },
            "sourceCommit": {
              "type": "string", "pattern": "^(|[0-9a-f]{40})$"
            },
            "pullPolicy": {
              "type": "string", "enum": ["IfNotPresent", "Always"]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "parallel": {
      "type": "object",
      "required": ["tp_size", "ep_size", "pp_size"],
      "properties": {
        "tp_size": {"const": 1},
        "ep_size": {"const": 1},
        "pp_size": {"const": 1}
      },
      "additionalProperties": false
    },
    "model": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "profileId", "id", "localPath", "revision", "tokenizerRevision",
            "configSha256", "dtype", "kvLayout", "tokensPerBlock",
            "kvBlockBytes", "kvCompatibilityId", "numHiddenLayers",
            "numKeyValueHeads", "headDim", "ropeTheta", "maxModelLen",
            "maxNumBatchedTokens", "maxNumSeqs", "gpuMemoryUtilization",
            "enforceEager"
          ],
          "properties": {
            "profileId": {"const": "week12-qwen3-0.6b"},
            "id": {"const": "Qwen/Qwen3-0.6B"},
            "localPath": {"const": "/opt/models/Qwen3-0.6B"},
            "revision": {"const": "9d4bfd9a94aa5f2ab18d77fa457c306da0b8e439"},
            "tokenizerRevision": {"const": "9d4bfd9a94aa5f2ab18d77fa457c306da0b8e439"},
            "configSha256": {"const": "660db3b73d788119c04535e48cf9be5f55bc3100841a718637ae695b442f27dd"},
            "dtype": {"const": "bfloat16"},
            "kvLayout": {"const": "NHDC"},
            "tokensPerBlock": {"const": 256},
            "kvBlockBytes": {"const": 29360128},
            "kvCompatibilityId": {"const": "a305c48442086f050a0f703c9e79e6e4596c52eaf5dd9f9015cc1a744c1b5b19"},
            "numHiddenLayers": {"const": 28},
            "numKeyValueHeads": {"const": 8},
            "headDim": {"const": 128},
            "ropeTheta": {"const": "1000000.0"},
            "maxModelLen": {"const": 4096},
            "maxNumBatchedTokens": {"const": 16384},
            "maxNumSeqs": {"const": 512},
            "gpuMemoryUtilization": {"const": 0.9},
            "enforceEager": {"const": false}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "profileId", "id", "localPath", "revision", "tokenizerRevision",
            "configSha256", "dtype", "kvLayout", "tokensPerBlock",
            "kvBlockBytes", "kvCompatibilityId", "numHiddenLayers",
            "numKeyValueHeads", "headDim", "ropeTheta", "maxModelLen",
            "maxNumBatchedTokens", "maxNumSeqs", "gpuMemoryUtilization",
            "enforceEager"
          ],
          "properties": {
            "profileId": {"const": "qwen3-8b-bf16-tp1"},
            "id": {"const": "Qwen/Qwen3-8B"},
            "localPath": {"const": "/opt/models/Qwen3-8B"},
            "revision": {"const": "b968826d9c46dd6066d109eabc6255188de91218"},
            "tokenizerRevision": {"const": "b968826d9c46dd6066d109eabc6255188de91218"},
            "configSha256": {"const": "f7c4eadfbbf522470667b797a3c89be2524832d2d599797248dc304fff447c30"},
            "dtype": {"const": "bfloat16"},
            "kvLayout": {"const": "NHDC"},
            "tokensPerBlock": {"const": 256},
            "kvBlockBytes": {"const": 37748736},
            "kvCompatibilityId": {"const": "2647222531d143800a56551dbe8d030c535a1bb2e0e47ff2a12f0781964f4c6c"},
            "numHiddenLayers": {"const": 36},
            "numKeyValueHeads": {"const": 8},
            "headDim": {"const": 128},
            "ropeTheta": {"const": "1000000.0"},
            "maxModelLen": {"const": 4096},
            "maxNumBatchedTokens": {"const": 16384},
            "maxNumSeqs": {"const": 128},
            "gpuMemoryUtilization": {"const": 0.9},
            "enforceEager": {"const": false}
          },
          "additionalProperties": false
        }
      ]
    },
    "worker": {
      "type": "object",
      "required": [
        "topologyGeneration", "members", "rendezvousPort",
        "requireGpudirectRdma", "maxBytesInflightPerPair", "nccl", "image"
      ],
      "properties": {
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
        "topologyGeneration": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "rendezvousPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "requireGpudirectRdma": {"type": "boolean"},
        "ncclWatchdogTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maxBytesInflightPerPair": {"const": 1073741824},
        "nccl": {
          "type": "object",
          "required": [
            "socketIfname", "ibDisable", "p2pDisable", "shmDisable",
            "debugSubsystems"
          ],
          "properties": {
            "socketIfname": {"type": "string", "minLength": 1},
            "ibDisable": {"const": true},
            "p2pDisable": {"const": true},
            "shmDisable": {"const": true},
            "debugSubsystems": {"const": "INIT,NET"}
          }
        },
        "members": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "role", "globalRank", "nodeGroup"]
          }
        },
        "image": {
          "type": "object",
          "required": [
            "repository", "tag", "digest", "sourceUrl", "sourceCommit",
            "pullPolicy"
          ],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {
              "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"
            },
            "sourceUrl": {
              "type": "string", "format": "uri", "minLength": 1
            },
            "sourceCommit": {
              "type": "string", "pattern": "^(|[0-9a-f]{40})$"
            },
            "pullPolicy": {
              "type": "string", "enum": ["IfNotPresent", "Always"]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "affinity": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "nats": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^nats://[^\\s]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["gateway"],
        "properties": {
          "gateway": {
            "required": ["performanceHarness"],
            "properties": {
              "performanceHarness": {
                "required": ["enabled"],
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "properties": {"profileId": {"const": "qwen3-8b-bf16-tp1"}}
          },
          "gateway": {
            "properties": {
              "correctnessHarness": {
                "properties": {"enabled": {"const": false}}
              },
              "routeParityHarness": {
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["model"],
        "properties": {
          "model": {
            "required": ["profileId"],
            "properties": {
              "profileId": {"const": "qwen3-8b-bf16-tp1"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "gateway": {
            "properties": {
              "correctnessHarness": {
                "properties": {"enabled": {"const": false}}
              },
              "performanceHarness": {
                "properties": {"enabled": {"const": true}}
              },
              "routeParityHarness": {
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["gateway"],
        "properties": {
          "gateway": {
            "required": ["correctnessHarness"],
            "properties": {
              "correctnessHarness": {
                "required": ["enabled"],
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "properties": {"profileId": {"const": "week12-qwen3-0.6b"}}
          },
          "gateway": {
            "properties": {
              "performanceHarness": {
                "properties": {"enabled": {"const": false}}
              }
            }
          }
        }
      }
    }
  ]
}
