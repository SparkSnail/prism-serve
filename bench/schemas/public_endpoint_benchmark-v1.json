{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prism public endpoint benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_level",
    "claims_not_made",
    "endpoint",
    "model",
    "cell",
    "requests",
    "concurrency",
    "expected_input_tokens",
    "expected_output_tokens",
    "successful_requests",
    "elapsed_s",
    "successful_requests_per_s",
    "metrics",
    "provenance",
    "runtime_identity",
    "rows"
  ],
  "properties": {
    "schema_version": {"const": "prism.public_endpoint_benchmark/v1"},
    "evidence_level": {
      "enum": ["timing-only", "paired-provenance"]
    },
    "claims_not_made": {"type": "array", "items": {"type": "string"}},
    "endpoint": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "cell": {"type": "string", "minLength": 1},
    "requests": {"type": "integer", "minimum": 1},
    "concurrency": {"type": "integer", "minimum": 1},
    "expected_input_tokens": {"type": ["integer", "null"]},
    "expected_output_tokens": {"type": "integer", "minimum": 2},
    "successful_requests": {"type": "integer", "minimum": 0},
    "elapsed_s": {"type": "number", "minimum": 0},
    "successful_requests_per_s": {"type": ["number", "null"], "minimum": 0},
    "metrics": {"type": "object"},
    "provenance": {"type": ["object", "null"]},
    "runtime_identity": {"type": ["object", "null"]},
    "rows": {"type": "array", "minItems": 1}
  }
}
